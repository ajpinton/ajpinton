# Device Setup & Activation
"albert.apple.com:443" # Device activation
#"captive.apple.com:80" # Optional: Captive portal detection
#"captive.apple.com:443" # Optional: Captive portal detection
"humb.apple.com:443" # Device provisioning
"static.ips.apple.com:80" # IP geolocation
"static.ips.apple.com:443" # IP geolocation
#"sq-device.apple.com:443" # Optional: eSIM activation (not needed for macOS)
"tbsc.apple.com:443" # Device setup
#"time.apple.com:123" # Optional: NTP time sync - UDP and cannot be checked with nc.
#"time-ios.apple.com:123" # Optional: iOS-specific NTP - UDP and cannot be checked with nc.
#"time-macos.apple.com:123" # Optional: macOS-specific NTP - UDP and cannot be checked with nc.

# Device Management
"deviceenrollment.apple.com:443" # Automated Device Enrollment
"deviceservices-external.apple.com:443" # Activation Lock management
"gdmf.apple.com:443" # Software update catalog
"identity.apple.com:443" # APNs certificate portal
"iprofiles.apple.com:443" # Enrollment profiles for ASM/ABM
"mdmenrollment.apple.com:443" # MDM enrollment profile upload and lookup
#"axm-servicediscovery.apple.com" # Optional: Account-driven enrollment discovery
#"setup.icloud.com:443" # Optional: Managed Apple ID login for Shared iPad

# Software Updates and App Store
#"appldnld.apple.com:80" # Optional: iOS/iPadOS updates
"gg.apple.com:80" # Software update catalog
"gg.apple.com:443" # Software update catalog
"gs.apple.com:80" # OS updates (all platforms)
"gs.apple.com:443" # OS updates (all platforms)
"ig.apple.com:443" # macOS updates
"mesu.apple.com:80" # Software update metadata
"mesu.apple.com:443" # Software update metadata
"swcdn.apple.com:80" # macOS update content
"swcdn.apple.com:443" # macOS update content
"swdownload.apple.com:80" # macOS update content
"swdownload.apple.com:443" # macOS update content
"swdist.apple.com:443" # macOS update distribution
"swscan.apple.com:80" # macOS update scanning
"swscan.apple.com:443" # macOS update scanning
