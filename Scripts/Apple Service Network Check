# Jamf Pro Hosts
"jamfcloud.com:443"
"use1-jcds.services.jamfcloud.com:443"

# Jamf Protect Hosts
"s3.amazonaws.com:443"
"a3bwx220ks5p1x-ats.iot.us-east-1.amazonaws.com:443"
"prod-use1-jamf-jpt-configs.s3.amazonaws.com:443"
"a3bwx220ks5p1x-ats.iot.us-west-2.amazonaws.com:443"
"prod-usw2-jamf-jpt-configs.s3.amazonaws.com:443"

# Apple Hosts
"apple.com:80"
