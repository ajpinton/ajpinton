"gdmf-ados.apple.com:443" # Additional software update catalog
"gsra.apple.com:443" # Additional OS update components
"wkms-public.apple.com:443" # Optional: OS installation on attached devices
"fcs-keys-pub-prod.cdn-apple.com:443" # Optional: OS installation on attached devices
"itunes.apple.com:443" # App Store and media services
"apps.apple.com:443" # App Store content
"mzstatic.com:443" # App/media content and alternative marketplaces
"oscdn.apple.com:80" # macOS Recovery
"oscdn.apple.com:443" # macOS Recovery
"osrecovery.apple.com:80" # macOS Recovery
"osrecovery.apple.com:443" # macOS Recovery
"skl.apple.com:80" # macOS updates
"skl.apple.com:443" # macOS updates
"updates.cdn-apple.com:443" # Software update downloads
"xp.apple.com:443" # OS update and provisioning
"configuration.apple.com:443" # Rosetta 2 installation
# iCloud and Apple Account
"account.apple.com:443" # Apple ID account management
"appleid.cdn-apple.com:443" # Apple ID services
"idmsa.apple.com:443" # Apple ID authentication

# Security and Certificates
"ocsp.apple.com:80" # Certificate validation
"ocsp2.apple.com:443" # Certificate validation
"crl.apple.com:80" # Certificate revocation list
"certs.apple.com:443" # Certificate services
"crl3.digicert.com:80" # Third-party certificate revocation
"crl4.digicert.com:80" # Third-party certificate revocation
"ocsp.digicert.com:80" # Third-party certificate validation
"valid.apple.com:443" # Certificate validation

# Apple Intelligence (Optional)
"guzzoni.apple.com:443" # Siri and dictation
#"*.smoot.apple.com:443" # Optional: Search services (Siri, Spotlight, Safari, etc.)
"apple-relay.cloudflare.com:443" # Private Cloud Compute
"apple-relay.fastly-edge.com:443" # Private Cloud Compute
"cp4.cloudflare.com:443" # Private Cloud Compute
"apple-relay.apple.com:443" # Apple Intelligence extensions
# Associated Domains (Required for SSO Extensions)
"app-site-association.cdn-apple.com:443" # Universal links
"app-site-association.networking.apple:443" # Universal links
)

# Add courier.push.apple.com hosts (1–50) for ports 443 and 5223
for i in {1..50}; do
  hosts_ports+=("${i}-courier.push.apple.com:443")
  hosts_ports+=("${i}-courier.push.apple.com:5223")
done

# Run connectivity checks
for entry in "${hosts_ports[@]}"; do
  IFS=":" read -r host port <<< "$entry"
  echo "Checking $host on port $port..."
  nc -zv -w "$TIMEOUT" "$host" "$port" &>/dev/null
  if [[ $? -eq 0 ]]; then
    echo "$host:$port is reachable"
  else
    echo "$host:$port is not reachable (timeout or refused)"
  fi
done
